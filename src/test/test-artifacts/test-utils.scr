module test_utils where

extern printf(format: u8*, ...): void;
extern exit(status: i32): void;

export proc start(func_name: u8*): void {
        printf("  %s()\n", func_name);
}

export proc fail(void): void {
        printf("  test failed!\n");
        exit(1);
}

export proc ok(void): void {
        printf("ok\n");
}

export proc begin(filename: u8*): void {
        printf("%s...\n", filename);
}
