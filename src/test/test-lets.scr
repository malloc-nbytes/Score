module test_lets where

extern printf(format: u8*, ...): i32;
extern strcmp(s1: u8*, s2: u8*): i32;
extern exit(c: i32): void;

proc test_i64(void): i32 {
        printf("  test_i64()\n");
        let x: i64 = 1;
        let y: i64 = 2;
        let n: i64 = 0-10;

        if (x == y) {
                return 0;
        }
        if (x+1 != y) {
                return 0;
        }
        if (n > 0 || n < 0-10) {
                return 0;
        }

        return 1;
}

proc test_str_assignments(void): i32 {
        printf("  test_str_assignments()\n");
        let s1: u8* = "hello world";
        let s2: u8* = "foo";
        let s3: u8* = "hello world";
        let s4: u8* = "       string      ";
        let s5: u8* = "       string";

        if (strcmp(s1, "hello world") != 0) {
                return 0;
        }
        if (strcmp(s1, s2) == 0) {
                return 0;
        }
        if (strcmp(s1, s3) != 0) {
                return 0;
        }
        if (strcmp(s2, "foo") != 0) {
                return 0;
        }
        if (strcmp(s1, s1) != 0) {
                return 0;
        }
        if (strcmp(s4, s5) == 0) {
                return 0;
        }

        return 1;
}

proc test_basic_assignment(void): i32 {
        printf("  test_basic_assignment()\n");

        let x: i32 = 1;
        let y: i32 = 2;
        let z: i32 = x + (y * 2);

        if (x != 1) {
                return 0;
        } else if (y != 2) {
                return 0;
        } else if (z != 5) {
                return 0;
        }

        return 1;
}

proc fail(void): void {
        printf("  test failed!\n");
        exit(1);
}

export proc main(void): i32 {
        printf("test-lets.scr...\n");
        if (test_basic_assignment() == 0) {
                fail();
        }
        if (test_str_assignments() == 0) {
                fail();
        }
        if (test_i64() == 0) {
                fail();
        }
        printf("ok\n");

        return 0;
}
