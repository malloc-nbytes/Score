module test_procs where

import test_utils;

extern strcmp(s1: u8*, s2: u8*): i32;

proc fib(n: i32): i32 {
        if (n < 2) {
                return n;
        }
        return fib(n-1) + fib(n-2);
}

proc sum(a: i32, b: i32): i32 {
        return a + b;
}

proc test_pass_str_helper(s: u8*): u8* {
        if (strcmp(s, "foo") != 0) {
                return "";
        }
        return s;
}

proc test_pass_str_as_param(x: i32, s: u8*, y: i32): void {
        start("test_pass_str_as_param");
        if (x != 1) {
                return 0;
        }
        if (y != 2) {
                return 0;
        }
        if (strcmp(s, "foo") != 0) {
                return 0;
        }
        return 1;
}

proc test_pass_str(void): i32 {
        start("test_pass_str");
        let s: u8* = "foo";
        let res: u8* = test_pass_str_helper(s);
        if (strcmp(s, res) != 0) {
                return 0;
        }
        return 1;
}

proc test_rec(void): i32 {
        start("test_rec");
        if (fib(10) != 55) {
                return 0;
        }
        return 1;
}

proc test_sum(void): i32 {
        start("test_sum");
        let x: i32 = 1;
        let y: i32 = 2;
        if (sum(x, y) != 3) {
                return 0;
        }
        if (sum(4, 5) != 9) {
                return 0;
        }
        return 1;
}

export proc main(void): i32 {
        begin("test-procs.scr");
        if (test_rec() == 0) {
                fail();
        }
        if (test_sum() == 0) {
                fail();
        }
        if (test_pass_str() == 0) {
                fail();
        }
        if (test_pass_str_as_param(1, "foo", 2) == 0) {
                fail();
        }
        ok();

        return 0;
}
