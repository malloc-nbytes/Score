extern printf(format: u8*, ...): i32;

proc fib(n: i32): i32 {
    if (n < 2) {
        return n;
    }
    return fib(n-1) + fib(n-2);
}

proc sum(a: i32, b: i32): i32 {
    return a + b;
}

proc test_rec(void): i32 {
    printf("  test_rec()\n");
    if (fib(10) != 55) {
        return 0;
    }
    return 1;
}

proc test_sum(void): i32 {
    printf("  test_sum()\n");
    let x: i32 = 1;
    let y: i32 = 2;
    if (sum(x, y) != 3) {
        return 0;
    }
    if (sum(4, 5) != 9) {
        return 0;
    }
    return 1;
}

export proc main(void): i32 {
    printf("test-procs.scr...\n");
    if (test_rec() == 0) {
        printf("  test failed!\n");
        return 0;
    }
    if (test_sum() == 0) {
        printf("  test failed!\n");
        return 0;
    }
    printf("ok\n");

    return 0;
}
