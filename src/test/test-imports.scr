module test_imports where

extern printf(format: u8*, ...): i32;
extern exit(c: i32): void;

import imports_artifacts;

proc test_import_proc_chaining(void): i32 {
        printf("  test_import_proc_chaining()\n");
        if (get_1() != 1) {
                return 0;
        }
        return 1;
}

proc test_basic_import(void): i32 {
        printf("  test_basic_import()\n");
        let s: i32 = sub(2, 1);
        if (s != 1) {
                return 0;
        }
        return 1;
}

proc fail(void): void {
        printf("  test failed!\n");
        exit(1);
}

export proc main(void): i32 {
        printf("test-imports.scr...\n");
        if (test_basic_import() == 0) {
                fail();
        }
        if (test_import_proc_chaining() == 0) {
                fail();
        }
        printf("ok\n");

        return 0;
}
