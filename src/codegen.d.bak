module codegen;

import std.stdio;
import std.conv;
import std.algorithm;
import std.file : write, exists, remove;
import std.process : execute;

import grammar;
import visitor;
import runtimeTypes;

class Context {
        string[] rotdata         = [];
        string[] bss             = [];
        string[] data            = [];
        string[] text            = [];
        string[] externs         = [];
        const string noexecstack = "section .note.GNU-stack noalloc noexec nowrite progbits";
        const string s           = "    ";
        RuntimeType* current_return_type;

        struct Symbol {
                string name;
                size_t offset; // Offset from rbp (e.g., [rbp - 8])
                RuntimeType* type;
                bool fun;
                bool variadic;
        }

        Symbol[] symbols; // Stack-based, no scope yet
        size_t stack_offset = 0; // Total stack space used

        this() {
                this.rotdata ~= "section .rotdata";
                this.bss     ~= "section .bss";
                this.data    ~= "section .data";
                this.text    ~= "section .text\nglobal main\n";
        }

        void addSymbol(string name, RuntimeType* type, bool isFunction = false, bool variadic = false) {
                size_t size = isFunction ? 0 : getTypeSize(type);  // No stack space for functions
                stack_offset += size;
                symbols ~= Symbol(name, stack_offset, type, isFunction, variadic);
        }

        // Find a symbol by name (returns null if not found)
        Symbol* findSymbol(string name) {
                foreach (ref sym; symbols) {
                        if (sym.name == name) {
                                return &sym;
                        }
                }
                return null;
        }

        void extern_(string name) {
                this.externs ~= "extern " ~ name;
        }

        void prologue(string name) {
                this.text ~= name ~ ":";
                this.text ~= this.s ~ "push rbp";
                this.text ~= this.s ~ "mov rbp, rsp";
        }

        void epilogue() {
                // this.text ~= this.s ~ "mov rsp, rbp"; //
                // this.text ~= this.s ~ "add rsp, " ~ stack_offset.to!string;
                // this.text ~= this.s ~ "pop rbp";
                this.text ~= this.s ~ "pop rbp";
        }

        char[] write() {
                char[] res = [];
                foreach (const ref string s; this.externs) res ~= s ~ '\n';
                foreach (const ref string s; this.rotdata) res ~= s ~ '\n';
                foreach (const ref string s; this.bss)     res ~= s ~ '\n';
                foreach (const ref string s; this.data)    res ~= s ~ '\n';
                foreach (const ref string s; this.text)    res ~= s ~ '\n';
                res ~= '\n' ~ this.noexecstack ~ '\n';
                return res;
        }
}

void compileExprBin(Visitor* v, ExprBin e) {
        Context* c = cast(Context*)v.context;

        // Compile operands (assuming type info would come from semantic analysis)
        e.l.accept(e.l, v);  // Left result in rax
        c.text ~= c.s ~ "push rax";
        e.r.accept(e.r, v);  // Right result in rax
        c.text ~= c.s ~ "pop rbx";

        // Note: Actual type should come from semantic analysis
        // For now, assuming 64-bit operations
        switch (e.op.lx) {
        case "+":
                c.text ~= c.s ~ "add rax, rbx";
                break;
        case "-":
                c.text ~= c.s ~ "sub rax, rbx";
                break;
        case "*":
                c.text ~= c.s ~ "imul rax, rbx";  // Signed multiplication
                break;
        case "/":
                c.text ~= c.s ~ "mov rdx, 0";
                c.text ~= c.s ~ "idiv rbx";  // Signed division
                break;
        default:
                c.text ~= c.s ~ "; TODO: Unsupported binary operator " ~ e.op.lx.idup;
        }
}

void compileExprUn(Visitor* v, ExprUn e) {
        Context* c = cast(Context*)v.context;

        e.e.accept(e.e, v);  // Result in rax

        switch (e.op.lx) {
        case "-":
                c.text ~= c.s ~ "neg rax";
                break;
        case "!":
                c.text ~= c.s ~ "cmp rax, 0";
                c.text ~= c.s ~ "sete al";
                c.text ~= c.s ~ "movzx rax, al";
                break;
        default:
                c.text ~= c.s ~ "; TODO: Unsupported unary operator " ~ e.op.lx.idup;
        }
}

void compileExprStrLit(Visitor* v, ExprStrLit e) {
        Context* c = cast(Context*)v.context;

        static size_t str_count = 0;
        string label = "str_" ~ str_count++.to!string;

        c.rotdata ~= label ~ ": db \"" ~ e.s.lx.idup ~ "\", 0";
        c.text ~= c.s ~ "lea rax, [" ~ label ~ "]";
}

void compileExprIntLit(Visitor* v, ExprIntLit e) {
        Context* c = cast(Context*)v.context;

        // Assuming 64-bit integers for literals unless specified
        c.text ~= c.s ~ "mov rax, " ~ e.i.lx.idup;
}

void compileExprIdent(Visitor* v, ExprIdent e) {
        Context* c = cast(Context*)v.context;

        string name = e.id.lx.idup;
        Context.Symbol* sym = c.findSymbol(name);

        if (sym is null) {
                c.text ~= c.s ~ "; ERROR: Undefined symbol " ~ name;
                return;
        }

        size_t size = getTypeSize(sym.type);
        string size_spec = size == 8 ? "qword" :
                size == 4 ? "dword" :
                size == 2 ? "word" : "byte";
        string reg = size == 8 ? "rax" :
                size == 4 ? "eax" :
                size == 2 ? "ax" : "al";

        // Load the value from memory into the appropriate register size
        c.text ~= c.s ~ "mov " ~ reg ~ ", " ~ size_spec ~ " [rbp - " ~ sym.offset.to!string ~ "]";

        // Extend to 64-bit rax if needed
        if (size < 8) {
                if (sym.type.b == RuntimeTypeBase.U8 ||
                    sym.type.b == RuntimeTypeBase.U16 ||
                    sym.type.b == RuntimeTypeBase.U32) {
                        c.text ~= c.s ~ "movzx rax, " ~ reg;  // Zero-extend for unsigned
                } else {
                        c.text ~= c.s ~ "movsx rax, " ~ reg;  // Sign-extend for signed
                }
        }
}

void compileExprMut(Visitor* v, ExprMut e) {
        Context* c = cast(Context*)v.context;

        if (auto ident = cast(ExprIdent)e.l) {
                string name = ident.id.lx.idup;
                Context.Symbol* sym = c.findSymbol(name);

                if (sym is null) {
                        c.text ~= c.s ~ "; ERROR: Undefined symbol " ~ name;
                        return;
                }

                e.r.accept(e.r, v);  // Result in rax

                size_t size = getTypeSize(sym.type);
                string size_spec = size == 8 ? "qword" :
                        size == 4 ? "dword" :
                        size == 2 ? "word" : "byte";
                string reg = size == 8 ? "rax" :
                        size == 4 ? "eax" :
                        size == 2 ? "ax" : "al";

                if (size < 8) {
                        c.text ~= c.s ~ "mov " ~ reg ~ ", eax";  // Truncate to appropriate size
                }
                c.text ~= c.s ~ "mov " ~ size_spec ~ " [rbp - " ~ sym.offset.to!string ~ "], " ~ reg;
        } else {
                c.text ~= c.s ~ "; ERROR: Left side of assignment must be an identifier";
        }
}

void compileExprProcCall(Visitor* v, ExprProcCall e) {
        Context* c = cast(Context*)v.context;

        if (auto ident = cast(ExprIdent)e.l) {
                string proc_name = ident.id.lx.idup;
                string[] regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"];

                Context.Symbol* sym = c.findSymbol(proc_name);
                bool isVariadic = sym !is null && sym.variadic;

                // Evaluate arguments
                size_t arg_count = min(e.exprs.length, 6);
                for (size_t i = 0; i < arg_count; i++) {
                        e.exprs[i].accept(e.exprs[i], v);
                        c.text ~= c.s ~ "mov " ~ regs[i] ~ ", rax";
                }

                // Align stack to 16 bytes (assuming rsp was aligned at function entry)
                c.text ~= c.s ~ "sub rsp, 8"; // Adjust for alignment
                if (isVariadic) {
                        c.text ~= c.s ~ "xor al, al"; // No FP args
                }
                c.text ~= c.s ~ "call " ~ proc_name;
                c.text ~= c.s ~ "add rsp, 8"; // Restore stack
        } else {
                c.text ~= c.s ~ "; ERROR: Procedure call must use identifier";
        }
}

void compileStmtLet(Visitor* v, StmtLet s) {
        Context* c = cast(Context*)v.context;

        size_t var_size = getTypeSize(s.t);
        if (var_size == 0) assert(0, "Cannot allocate variable with void type");

        string var_name = s.id.lx.idup;
        c.addSymbol(var_name, s.t);

        // Allocate stack space, rounded up to maintain alignment
        size_t aligned_size = (var_size + 15) & ~15; // Round up to 16 bytes
        c.text ~= c.s ~ "sub rsp, " ~ aligned_size.to!string;
        c.stack_offset += aligned_size; // Track total allocation

        c.text ~= c.s ~ "; " ~ var_name ~ " at [rbp - " ~ var_size.to!string ~ "]";

        if (s.e !is null) {
                s.e.accept(s.e, v); // Result in rax

                string size_spec = var_size == 8 ? "qword" :
                        var_size == 4 ? "dword" :
                        var_size == 2 ? "word" : "byte";
                string reg = var_size == 8 ? "rax" :
                        var_size == 4 ? "eax" :
                        var_size == 2 ? "ax" : "al";

                if (var_size < 8 && (s.t.b == RuntimeTypeBase.U8 || s.t.b == RuntimeTypeBase.U16 || s.t.b == RuntimeTypeBase.U32)) {
                        c.text ~= c.s ~ "movzx " ~ reg ~ ", " ~ reg;
                }
                c.text ~= c.s ~ "mov " ~ size_spec ~ " [rbp - " ~ var_size.to!string ~ "], " ~ reg;
        }
}

void compileStmtExpr(Visitor* v, StmtExpr s) {
        Context* c = cast(Context*)v.context;

        // Save stack state
        size_t prev_stack_offset = c.stack_offset;

        // Compile the expression
        s.e.accept(s.e, v);

        // Check for stack imbalance (unlikely with current expr codegen)
        if (c.stack_offset > prev_stack_offset) {
                size_t bytes_to_free = c.stack_offset - prev_stack_offset;
                c.text ~= c.s ~ "add rsp, " ~ bytes_to_free.to!string;
                c.text ~= c.s ~ "; Warning: Expression left " ~ bytes_to_free.to!string ~ " bytes on stack";
        }

        c.text ~= c.s ~ "; Expression result in rax (discarded)";
}

void compileStmtProc(Visitor* v, StmtProc s) {
        Context* c = cast(Context*)v.context;

        string proc_name = s.id.lx.idup;
        c.current_return_type = s.rtype;
        c.prologue(proc_name);

        // Reset stack offset for this procedure
        size_t prev_stack_offset = c.stack_offset;
        c.stack_offset = 0;

        // Compile the body
        s.b.accept(s.b, v);

        // Only add default return if no return statement was encountered
        // (This will be overridden by compileStmtReturn if present)
        if (s.rtype.b == RuntimeTypeBase.I32) {
                c.text ~= c.s ~ "mov rax, 0"; // Default return 0
        }

        // Epilogue: cleanup stack and return
        if (c.stack_offset > 0) {
                size_t aligned_bytes = (c.stack_offset + 15) & ~15; // Round up to 16-byte boundary
                c.text ~= c.s ~ "add rsp, " ~ aligned_bytes.to!string; // Clean up local variables
        }
        c.text ~= c.s ~ "pop rbp";
        c.text ~= c.s ~ "ret";

        // Restore stack offset for outer scope
        c.stack_offset = prev_stack_offset;
}

void compileStmtBlock(Visitor* v, StmtBlock s) {
        Context* c = cast(Context*)v.context;
        size_t prev_stack_offset = c.stack_offset;

        for (size_t i = 0; i < s.stmts.length; ++i) {
                s.stmts[i].accept(s.stmts[i], v);
        }

        if (c.stack_offset > prev_stack_offset) {
                size_t bytes_used = c.stack_offset - prev_stack_offset;
                size_t aligned_bytes = (bytes_used + 15) & ~15;  // Round up to 16-byte boundary
                if (aligned_bytes > bytes_used) {
                        c.text ~= c.s ~ "sub rsp, " ~ (aligned_bytes - bytes_used).to!string;  // Align
                }
                c.text ~= c.s ~ "add rsp, " ~ aligned_bytes.to!string;  // Clean up
        }

        while (c.symbols.length > 0 && c.symbols[$-1].offset > prev_stack_offset) {
                c.symbols.length--;
        }
        c.stack_offset = prev_stack_offset;
}

void compileStmtReturn(Visitor* v, StmtReturn s) {
        Context* c = cast(Context*)v.context;

        s.e.accept(s.e, v); // Result in rax

        size_t return_size = getTypeSize(c.current_return_type);
        string reg = return_size == 8 ? "rax" :
                return_size == 4 ? "eax" :
                return_size == 2 ? "ax" : "al";

        if (return_size < 8 && (c.current_return_type.b == RuntimeTypeBase.U8 ||
                                c.current_return_type.b == RuntimeTypeBase.U16 ||
                                c.current_return_type.b == RuntimeTypeBase.U32)) {
                c.text ~= c.s ~ "movzx " ~ reg ~ ", " ~ reg;
        }

        // Clean up stack and return
        if (c.stack_offset > 0) {
                size_t aligned_bytes = (c.stack_offset + 15) & ~15;
                c.text ~= c.s ~ "add rsp, " ~ aligned_bytes.to!string;
        }
        c.text ~= c.s ~ "pop rbp";
        c.text ~= c.s ~ "ret";
}

void compileStmtExtern(Visitor* v, StmtExtern s) {
        Context* c = cast(Context*)v.context;

        string proc_name = s.proto.id.lx.idup;

        // Check for redefinition
        if (c.findSymbol(proc_name) !is null) {
                c.text ~= c.s ~ "; ERROR: Redefinition of external symbol " ~ proc_name;
                return;
        }

        // Generate signature comment
        string sig = "extern " ~ proc_name ~ "(";
        foreach (i, param; s.proto.pn) {
                sig ~= s.proto.pt[i].b.to!string ~ " " ~ param.lx.idup;
                if (i < s.proto.pn.length - 1) sig ~= ", ";
        }
        sig ~= ") -> " ~ s.proto.rtype.b.to!string;
        // c.text ~= c.s ~ "; " ~ sig;
        c.externs ~= "; " ~ sig;

        // Add extern directive
        c.extern_(proc_name);

        // Add to symbol table as a function
        c.addSymbol(proc_name, s.proto.rtype, true, s.proto.variadic);
}

void compileStmtIf(Visitor* v, StmtIf s) {
        Context* c = cast(Context*)v.context;
        assert(0);
}

void compileStmtWhile(Visitor* v, StmtWhile s) {
        Context* c = cast(Context*)v.context;
        assert(0);
}

Visitor createCodegenContext(Context* c) {
        Visitor v;
        v.context         = cast(void*)c;

        v.visitExprBin      = &compileExprBin;
        v.visitExprUn       = &compileExprUn;
        v.visitExprStrLit   = &compileExprStrLit;
        v.visitExprIntLit   = &compileExprIntLit;
        v.visitExprIdent    = &compileExprIdent;
        v.visitExprMut      = &compileExprMut;
        v.visitExprProcCall = &compileExprProcCall;

        v.visitStmtLet      = &compileStmtLet;
        v.visitStmtExpr     = &compileStmtExpr;
        v.visitStmtProc     = &compileStmtProc;
        v.visitStmtBlock    = &compileStmtBlock;
        v.visitStmtReturn   = &compileStmtReturn;
        v.visitStmtExtern   = &compileStmtExtern;
        v.visitStmtIf       = &compileStmtIf;
        v.visitStmtWhile    = &compileStmtWhile;
        return v;
}

void gen(Program* p) {
        Context c = new Context();
        Visitor v = createCodegenContext(&c);

        for (size_t i = 0; i < p.stmts.length; ++i) {
                p.stmts[i].accept(p.stmts[i], &v);
        }

        string output_name = "output";
        bool debug_ = true;

        // Optionally print assembly for debugging
        if (debug_) {
                writeln("Generated assembly:");
                writeln(c.write());
        }

        string asmFile = output_name ~ ".asm";
        write(asmFile, c.write());

        string objFile = output_name ~ ".o";

        // Assemble with nasm, include debug symbols if requested
        string[] nasmArgs = ["nasm", "-f", "elf64", asmFile, "-o", objFile];
        if (debug_) {
                nasmArgs ~= "-g"; // Add debug symbols (DWARF format by default)
                nasmArgs ~= "-F dwarf"; // Specify DWARF debug format
                writeln(nasmArgs);
        }
        auto nasmResult = execute(nasmArgs);
        if (nasmResult.status != 0) {
                writeln("Assembly failed:");
                writeln(nasmResult.output);
                if (!debug_) {
                        if (exists(asmFile)) remove(asmFile);
                        if (exists(objFile)) remove(objFile);
                }
                return;
        }

        // Link with gcc, include debug symbols if requested
        string[] linkArgs = ["gcc", "-no-pie", objFile, "-o", output_name];
        if (debug_) {
                linkArgs ~= "-g"; // Preserve debug symbols
        }
        auto linkResult = execute(linkArgs);
        if (linkResult.status != 0) {
                writeln("Linking failed:");
                writeln(linkResult.output);
                goto cleanup;
        }

        writeln("Successfully compiled and linked to ", output_name);
        if (debug_) {
                writeln("Debug symbols included. Use 'gdb ", output_name, "' to debug.");
        }

 cleanup:
        // Keep files if debug is enabled for inspection
        if (!debug_) {
                if (exists(asmFile)) remove(asmFile);
                if (exists(objFile)) remove(objFile);
        }
}
